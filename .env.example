# Укажите собственный публичный DNS; порты 80/443 направлены на сервер.
RETRO_DOMAIN=retro.example.org
ACME_EMAIL=admin@example.org
# Тег конкретного релиза/коммита, не latest. Для локальной сборки:
# docker compose build --pull retro
RETRO_IMAGE=retro:production-1
RETRO_DATA_VOLUME=retro_data

# Необязательная Jira: подключается через compose.jira.yaml (deploy/JIRA.md).
# Токен хранится отдельно: deploy/secrets/jira_token, не в этом файле.
# JIRA_BASE_URL=https://jira.example.org
# JIRA_DEPLOYMENT=datacenter
# JIRA_PROJECT_KEY=TEAM
# JIRA_ISSUE_TYPE_ID=10001
# JIRA_AUTH_MODE=bearer
# Для Jira Cloud: JIRA_DEPLOYMENT=cloud, JIRA_AUTH_MODE=basic,
# JIRA_USER=почта аккаунта; в файле токена — API token без scopes.
# JIRA_EXTRA_FIELDS='{"customfield_12345":{"value":"Команда"}}'
